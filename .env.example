# ===========================================================================
# Celestial Indices - environment configuration
# Copy to `.env` and adjust.  Every value below is optional; the defaults
# shown are the ones the code falls back to when the variable is absent.
# ===========================================================================

# --- Database -------------------------------------------------------------
# SQLite (development default).  For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/celestial
DATABASE_URL=sqlite:///data/celestial_indices.db

# --- Data range -----------------------------------------------------------
# First date of the aligned dataset.  The trading calendar and the planetary
# ephemeris are always generated from this date.
DATA_START_DATE=2000-01-01

# --- Market data source ---------------------------------------------------
# Fallback chain used by src/data_pipeline.py:
#   jugaad -> nsepy/nsedt -> yahoo -> csv_cache -> synthetic
# Force a single source with: auto | jugaad | nsepy | yahoo | csv_cache | synthetic
MARKET_DATA_SOURCE=auto

# Directory holding cached index CSV files (used by the csv_cache source).
RAW_DATA_DIR=data/raw

# --- Planetary computation ------------------------------------------------
# Local time of the market close at which planetary positions are evaluated.
MARKET_CLOSE_LOCAL_TIME=15:30

# Time zone used to interpret MARKET_CLOSE_LOCAL_TIME.
MARKET_TIMEZONE=Asia/Kolkata

# Ayanamsa for the sidereal longitudes: lahiri (default), ram, krishnamurti.
AYANAMSA=lahiri

# --- Reports --------------------------------------------------------------
REPORTS_DIR=reports
PROCESSED_DATA_DIR=data/processed

# --- Scheduling (optional daily refresh) ----------------------------------
ENABLE_SCHEDULER=false
REFRESH_HOUR=18
REFRESH_MINUTE=45

# --- Live updater symbols -------------------------------------------------
# Yahoo backup/live feed. Leave a midcap value blank until its symbol is
# independently confirmed; the updater will record it as not_configured.
CELESTIAL_TICKER_SENSEX=^BSESN
CELESTIAL_TICKER_NIFTY_50=^NSEI
CELESTIAL_TICKER_NIFTY_BANK=^NSEBANK
CELESTIAL_TICKER_NIFTY_MIDCAP_100=
CELESTIAL_TICKER_NIFTY_MIDCAP_150=

# --- API ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
